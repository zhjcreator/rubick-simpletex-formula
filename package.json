{
  "name": "rubick-simpletex-formula",
  "pluginName": "SimpleTex 公式识别",
  "description": "在 rubick 中识别图片公式，编辑 LaTeX 并实时预览。",
  "author": "zhjcreator",
  "license": "MIT",
  "main": "index.html",
  "preload": "preload.js",
  "version": "0.2.2",
  "keywords": [
    "rubick",
    "rubick-plugin",
    "simpletex",
    "latex",
    "math-ocr",
    "formula-recognition",
    "equation-recognition",
    "ocr",
    "mathjax",
    "mathml",
    "word",
    "omml",
    "latex-ocr",
    "公式识别",
    "数学公式",
    "图片识别",
    "Word公式"
  ],
  "logo": "https://simpletex.cn/favicon.ico",
  "homepage": "https://github.com/zhjcreator/rubick-simpletex-formula#readme",
  "homePage": "https://github.com/zhjcreator/rubick-simpletex-formula",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhjcreator/rubick-simpletex-formula.git"
  },
  "bugs": {
    "url": "https://github.com/zhjcreator/rubick-simpletex-formula/issues"
  },
  "pluginType": "ui",
  "files": [
    "index.html",
    "preload.js",
    "renderer.js",
    "style.css",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "features": [
    {
      "code": "formula",
      "explain": "识别并编辑数学公式",
      "cmds": [
        "公式识别",
        "latex",
        "simpletex",
        "ocr",
        {
          "type": "img",
          "label": "识别图片公式"
        }
      ]
    }
  ],
  "scripts": {
    "lint": "node --check preload.js && node --check renderer.js"
  },
  "devDependencies": {}
}
